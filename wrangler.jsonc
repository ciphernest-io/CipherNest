{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ciphernest",
  "main": "./worker.js",
  "compatibility_date": "2026-07-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./web-viewer",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
