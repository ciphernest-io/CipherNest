{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ciphernest",
  "main": "./worker.js",
  "compatibility_date": "2026-07-05",
  "compatibility_flags": ["nodejs_compat"],
  // Two Custom Domains on one Worker. Applied on deploy: `wrangler deploy`
  // creates each DNS record + TLS cert automatically. This requires the
  // ciphernest.io zone to live on the same Cloudflare account you are
  // deploying from.
  //   share.ciphernest.io  the share viewer (every path)
  //   auth.ciphernest.io   ONLY /oauth-callback, the OneDrive OAuth return page
  //                        (worker.js 404s everything else on this host). Kept
  //                        on its own host so share-viewer changes can never
  //                        break sign-in again (the workers.dev outage did).
  "routes": [
    { "pattern": "share.ciphernest.io", "custom_domain": true },
    { "pattern": "auth.ciphernest.io", "custom_domain": true }
  ],
  "assets": {
    "directory": "./web-viewer",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker runs before the static-assets layer on EVERY request. It has
    // to: /proxy must reach worker.js (otherwise the SPA fallback serves
    // index.html for it and in-browser share decryption dies), and the
    // auth host's path restriction is a per-host rule that only code can
    // apply. worker.js hands everything else to env.ASSETS.fetch(), which
    // still applies the SPA fallback above.
    "run_worker_first": true
  },
  // Workers Logs. The shape Cloudflare now prompts for, with ONE deliberate
  // inversion: invocation_logs is false.
  //
  // Invocation logs are the automatic per-request records, and they include
  // the request URL. That is the problem. A share link whose '#' was
  // percent-encoded into '%23' by a messaging app carries the decryption key
  // in the PATH, and the OAuth callback on auth.ciphernest.io carries a
  // single-use authorization code in the query. Turning invocation logs on
  // would persist both for the retention window, which is 3 days on the free
  // plan and 7 on paid. For a product whose central claim is that the key is
  // never sent to a server, writing it into our own log store is the worst
  // possible place for it to land (MASVS report W-01).
  //
  // enabled stays true so explicit console.log output still works if we ever
  // add any. There is none today, and none should ever include a URL.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
