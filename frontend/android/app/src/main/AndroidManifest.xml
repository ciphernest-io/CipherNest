<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Declared here on purpose, not inherited from a plugin manifest
         (MASVS F-31): the app talks to the cloud provider, the share relay
         and the billing service, and the permission surface should say so
         in the file reviewers read. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Declared here on purpose, not inherited from a plugin manifest
         (MASVS F-31): the app talks to the cloud provider, the share relay
         and the billing service, and the permission surface should say so
         in the file reviewers read. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Declared here on purpose, not inherited from a plugin manifest
         (MASVS F-31): the app talks to the cloud provider, the share relay
         and the billing service, and the permission surface should say so
         in the file reviewers read. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Declared here on purpose, not inherited from a plugin manifest
         (MASVS F-31): the app talks to the cloud provider, the share relay
         and the billing service, and the permission surface should say so
         in the file reviewers read. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Declared here on purpose, not inherited from a plugin manifest
         (MASVS F-31): the app talks to the cloud provider, the share relay
         and the billing service, and the permission surface should say so
         in the file reviewers read. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- ACCESS_MEDIA_LOCATION is deliberately NOT declared.
         Reading the asset's original file rather than the MediaStore copy is
         what preserves the geotag (see MediaOrigin), and a device test on
         Android 16 confirmed the round trip keeps full GPS EXIF with this
         permission absent and denied. Declaring it would put a sensitive
         permission on the Play listing that buys nothing observable, so it
         stays off. If a device is ever found that redacts anyway, this is
         the line to restore (MASVS F-30). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER"/>
    <!-- Background music playback (just_audio_background). -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- Upload foreground service (UploadForegroundService): keeps an
         in-flight encrypt+upload alive when the user backgrounds the app.
         POST_NOTIFICATIONS also un-hides the auto-sync worker's progress
         notifications on Android 13+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- In-app capture (CaptureScreen): the camera plugin merges CAMERA
         itself, but declaring both here keeps the surface self-documenting.
         Captures land in app-private temp ONLY - the OEM camera app is
         deliberately never used (it saves plaintext copies to DCIM). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- allowBackup MUST stay false: Auto Backup would copy the wrapped seed
         (seed_blob_v1), the biometric blob, and the shares DB (which holds
         magic links with raw key fragments) to the user's Google Drive.
         Recovery story is the mnemonic, never device backup. -->
    <application
        android:label="CipherNest"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:name,android:allowBackup">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Flutter's built-in deep linking is OFF. It is on by default
                 since Flutter 3.27 and pushes every incoming VIEW intent's
                 path onto the Navigator as a named route: the OAuth return
                 (ciphernest-open://oauth-callback) became a pushed
                 "/oauth-callback" route, which our route table answers with
                 "Route not found" (MTR#2 D2, 19 Sep 2026). Share links are
                 handled by app_links in lib/src/app.dart, the OAuth return by
                 MainActivity.relayOAuthReturn; neither wants Flutter's copy. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- CipherNest share App Link.
                 autoVerify="true" tells Android to look up
                 https://share.ciphernest.io/.well-known/assetlinks.json
                 so the app opens directly. Without that file the user just
                 sees a one-time "Open with" chooser. Host must exactly match
                 AppConstants.shareHost in lib/src/config/constants.dart. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="share.ciphernest.io"
                      android:pathPrefix="/s/"/>
            </intent-filter>
            <!-- OAuth return relay: the worker callback page's button fires
                 scheme ciphernest-open at THIS activity so the app task
                 comes to the foreground; MainActivity.relayOAuthReturn
                 rewrites the URI to ciphernest and hands it to the plugin's
                 CallbackActivity in its own disposable task. A DISTINCT
                 scheme on purpose: giving MainActivity the plain ciphernest
                 scheme would create two filter matches and a chooser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="ciphernest-open"/>
            </intent-filter>
        </activity>
        <!-- OAuth2 redirect callback for flutter_web_auth_2.
             ONE delivery path, deliberately: the OAuth redirect_uri is the
             https /oauth-callback page (an https redirect_uri suppresses
             login.live.com's anti-phishing interstitial, which hangs in
             Custom Tabs), the page ALWAYS renders in the tab, and its
             button hands the code to this activity via a ciphernest://
             intent (user gesture -> Chrome dispatches custom-scheme
             intents reliably; it never dispatches http/https ones).
             Do NOT add an https App-Link filter here: when the link
             verifies, Android intercepts the redirect at the OS level and
             delivers scheme 'https' while the plugin waits on
             'ciphernest' — the callback drops and sign-in loops. Two
             racing delivery paths was exactly the bug. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ciphernest" />
            </intent-filter>
        </activity>

        <!-- Media session service + hardware button receiver for background
             music playback (just_audio_background / audio_service). -->
        <service android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <receiver android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Holds process priority while an encrypt+upload is in flight so
             backgrounding the app doesn't kill the transfer. The upload
             itself stays in Dart; this service only pins the process. -->
        <service android:name=".UploadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

        <!-- Receives onTaskRemoved when the app is swiped out of recents, so a
             swipe-away actually closes the vault instead of leaving the process
             alive behind the media notification. stopWithTask must stay false:
             with it true Android stops the service without ever calling
             onTaskRemoved, which is the only callback we want. -->
        <service android:name=".TaskExitService"
            android:exported="false"
            android:stopWithTask="false"/>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- purchases_flutter bundles Amazon Appstore support, which merges an
             EXPORTED broadcast receiver into the manifest. CipherNest ships to
             Google Play only, so that code path never executes, and an
             exported third-party receiver is attack surface for nothing. This
             took the app's exported-component count from 9 to 10; removing it
             puts it back. If Amazon distribution is ever wanted, delete this
             block rather than working around it. -->
        <receiver
            android:name="com.amazon.device.iap.ResponseReceiver"
            tools:node="remove" />

    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
